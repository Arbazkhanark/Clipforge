{
  "name": "clipforge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ClipForge - creator clipping, collections and Instagram publishing SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "prisma:generate": "DIRECT_URL=postgresql://127.0.0.1:5432/clipforge_generate?schema=public prisma generate",
    "postinstall": "npm run prisma:generate",
    "start": "next start",
    "test": "node --import tsx --import ./tests/helpers/register-css.mjs --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "db:validate": "node --env-file=.env.local ./node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate dev",
    "db:generate": "node --env-file=.env.local ./node_modules/prisma/build/index.js generate",
    "verify:harness": "CLIPFORGE_LOCAL_AUTH=true node --import tsx --import ./tests/helpers/register-css.mjs scripts/verify-harness.ts",
    "admin:preview": "node --import tsx scripts/admin-preview-harness.ts",
    "verify:browser": "node scripts/browser-check.mjs",
    "worker:publishing": "node --import tsx scripts/run-publishing-worker.ts",
    "worker:render": "node --import tsx scripts/run-render-worker.ts",
    "worker:media-import:once": "node --import tsx scripts/run-media-import-worker.ts",
    "worker:subscription-continuation": "node --import tsx scripts/run-subscription-continuation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.5",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
