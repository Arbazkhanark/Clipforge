{
  "name": "clipforge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ClipForge - creator clipping, collections and Instagram publishing SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --import ./tests/helpers/register-css.mjs --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@prisma/client": "^7",
    "@prisma/adapter-pg": "^7",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "prisma": "^7",
    "@types/pg": "latest"
  },
  "engines": {
    "node": ">=22.18"
  }
}