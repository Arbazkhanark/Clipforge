GOOGLE_CLIENT_ID='908532689791-roni1tk98in6t1ecquv7t1jue63gt8te.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET="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"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

