# Placeholders only. Never commit real values.
# Put the real Neon URLs in .env.local. That file is gitignored.
# DATABASE_URL is the pooled host (the hostname contains "-pooler") for the running app.
# DIRECT_URL is the direct host for Prisma migrations. Prisma 7.10 has one CLI URL, so prisma.config.ts reads DIRECT_URL.
DATABASE_URL='postgresql://user:password@localhost:5432/clipforge?schema=public'
DIRECT_URL='postgresql://user:password@localhost:5432/clipforge?schema=public'
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-long-random-string"
AWS_REGION="ap-south-1"
RAZORPAY_KEY_ID="replace-with-test-key-id"
RAZORPAY_KEY_SECRET="replace-with-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-test-webhook-secret"
# Create these recurring plans in the Razorpay TEST dashboard with the matching catalog amount and cadence.
# Checkout validates every provider plan against the catalog before creating a subscription.
RAZORPAY_PLAN_CREATOR_WEEKLY="plan_replace_creator_weekly"
RAZORPAY_PLAN_CREATOR_MONTHLY="plan_replace_creator_monthly"
RAZORPAY_PLAN_PRO_WEEKLY="plan_replace_pro_weekly"
RAZORPAY_PLAN_PRO_MONTHLY="plan_replace_pro_monthly"
RAZORPAY_PLAN_AGENCY_WEEKLY="plan_replace_agency_weekly"
RAZORPAY_PLAN_AGENCY_MONTHLY="plan_replace_agency_monthly"
# Razorpay requires a finite cycle count or end_at. Configure this deliberately; see billing limitations in docs.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=""
# Cancellation retains access until the provider-confirmed period end by default.
RAZORPAY_CANCEL_AT_CYCLE_END="true"

# Local development only. "true" = use built-in SAMPLE data held in server memory (resets on restart).
# Leave unset/false to see the honest "not signed in / not connected" behaviour.
CLIPFORGE_DEMO_MODE="false"
# Private folder for uploaded video and image files. Required when DATABASE_URL is set.
# Use a folder outside public/, app/, and .next/. This example path is gitignored.
# Database mode reports an error if the folder is missing. It does not save the files in memory.
CLIPFORGE_LOCAL_MEDIA_DIR=".local-media"
# Optional: technical cap for ONE upload in MB (default 200). Not a plan entitlement.
# CLIPFORGE_MAX_UPLOAD_MB="200"

# Email. Leave unset: no message is sent, and database accounts can sign in while unverified.
# "outbox" keeps messages on /dev/outbox for local development. It is refused in production.
# "smtp" is reserved. These placeholders do not send mail until a provider is approved.
# CLIPFORGE_EMAIL_PROVIDER="unavailable"
# CLIPFORGE_SMTP_HOST="smtp.example.com"
# CLIPFORGE_SMTP_PORT="587"
# CLIPFORGE_SMTP_USER="mailer"
# CLIPFORGE_SMTP_PASSWORD="replace-me"
# CLIPFORGE_EMAIL_FROM="ClipForge <mailer@example.com>"

# Local development only: real sign-up/sign-in with accounts held in server memory (lost on restart).
# "Emails" are shown on /dev/outbox - none are sent. Refused when NODE_ENV=production.
# CLIPFORGE_LOCAL_AUTH="true"
# CLIPFORGE_BASE_URL="http://localhost:3000"

# Google OAuth. Placeholders only. Do not put a real client secret in git.
# Create the OAuth client yourself in Google Cloud Console. This repo does not create that project.
# Authorised redirect URI, copied exactly:
#   http://localhost:3000/api/auth/google/callback
# Production must use https and the same path on the public origin.
# Leave these as replace-me until the client exists. The app then keeps email/password sign-in and refuses Google.
GOOGLE_CLIENT_ID='replace-with-google-client-id'
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Instagram Login. Placeholders only. Do not put a real app secret or token key in git.
# Create the Meta app yourself. This repo does not create that app or connect an account.
# Authorised redirect URI, copied exactly:
#   http://localhost:3000/api/instagram/callback
# INSTAGRAM_TOKEN_KEY is 32 bytes, base64url, used only on the server to encrypt access tokens.
# Leave these as replace-me until the app exists. The Connect button then explains that it is not configured.
INSTAGRAM_APP_ID="replace-with-instagram-login-app-id"
INSTAGRAM_APP_SECRET="replace-with-instagram-login-app-secret"
INSTAGRAM_OAUTH_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
INSTAGRAM_TOKEN_KEY="replace-with-32-byte-base64url-key"



# INSTAGRAM_PROVIDER=meta
# META_APP_ID=2739162099873020
# META_APP_SECRET=baf3e1795168aec60a51db51f41d71a0
# META_REDIRECT_URI=https://c380-103-248-93-13.ngrok-free.app/v1/instagram/callback
# # Confirm the exact scope strings in your Meta app dashboard (see docs/INSTAGRAM_SETUP.md)
# META_SCOPES=instagram_business_basic,instagram_business_content_publish
# # Keep this many publishes of headroom below Instagram's reported quota
# QUOTA_RESERVE=0

# Private S3 media storage. Development and production use different buckets and IAM identities.
# Set distinct environment-scoped values in local development and the deployment platform.
CLIPFORGE_STORAGE_PROVIDER="s3"
CLIPFORGE_STORAGE_ENV="development"
CLIPFORGE_S3_BUCKET="replace-with-development-bucket"
CLIPFORGE_S3_REGION="ap-south-1"
CLIPFORGE_S3_ACCESS_KEY_ID="replace-with-development-iam-access-key"
CLIPFORGE_S3_SECRET_ACCESS_KEY="replace-with-development-iam-secret-key"
# Optional when using temporary IAM credentials only.
# CLIPFORGE_S3_SESSION_TOKEN="replace-with-development-session-token"

# CLIPFORGE_LOCAL_MEDIA_DIR is an explicit development/test fallback only.
# Production and normal development must use the configured private S3 bucket.
