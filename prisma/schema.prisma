// ============================ Users & billing ============================
model User {
  id            String    @id @default(cuid())
  /// Stored lowercase and trimmed by the application (see src/server/auth/auth-service.ts).
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null for Google-only accounts
  name          String?
  role          UserRole  @default(user)
  createdAt     DateTime  @default(now())

  sessions        Session[]
  authTokens      AuthToken[]
  googleIdentity  GoogleIdentity?
  subscription   Subscription?
  razorpaySubscriptionIntents RazorpaySubscriptionIntent[]
  manualPaymentIntents ManualPaymentIntent[]
  manualPlanAccesses ManualPlanAccess[]
  promotionsCreated Promotion[] @relation("PromotionCreator")
  promotionsTargeted Promotion[] @relation("PromotionTarget")
  promotionRedemptions PromotionRedemption[]
  promotionalAccessGrants PromotionalAccessGrant[]
  promotionalGrantsCreated PromotionalAccessGrant[] @relation("PromotionGrantor")
  promotionEventsAsSubject PromotionLifecycleEvent[] @relation("PromotionEventSubject")
  promotionEventsAsActor PromotionLifecycleEvent[] @relation("PromotionEventActor")
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  collections    VideoCollection[]
  permissions    CollectionPermission[]
  accessRequests CollectionAccessRequest[]
  importJobs     MediaImportJob[]
  templates      EditingTemplate[]
  cycles         PublishingCycle[]
  notifications  Notification[]
  usageRecords   UsageRecord[]
  publishingJobs PublishingJob[]
  editedMediaReplacements EditedMediaReplacement[]
}

/// Login sessions. Only a SHA-256 hash of the cookie token is stored, so a database leak cannot be replayed as cookies.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

/// One-time tokens for email verification and password reset (hash only; single use; short expiry).
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

/// Pending first-Admin registration. Password and verification token are stored only as hashes.
model AdminRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  tokenHash    String   @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// One Google account per ClipForge user. The subject is Google's stable account id.
/// Access tokens and refresh tokens are not stored.
model GoogleIdentity {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleSub String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String // "free" | "creator" | "pro" | "agency" (validated by catalog.ts)
  interval               BillingInterval
  status                 SubscriptionStatus @default(created)
  razorpaySubscriptionId String?            @unique
  /**
   * Unix seconds of the last webhook event applied (ignores stale, out-of-order events).
   */
  lastEventAt            BigInt             @default(0)
  /// Unix seconds when a free trial ends (the start_at sent to Razorpay), or null.
  trialEndsAt            BigInt?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  /// Set before calling Razorpay cancellation; blocks continuation even if that call is ambiguous.
  cancellationRequestedAt DateTime?
  continuations          RazorpaySubscriptionContinuation[]
  checkoutIntent         RazorpaySubscriptionIntent? @relation(fields: [razorpaySubscriptionId, userId, planId, interval], references: [providerSubscriptionId, userId, planId, interval], onDelete: Restrict)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([razorpaySubscriptionId, userId, planId, interval])
  @@unique([id, razorpaySubscriptionId])
}

enum SubscriptionContinuationStatus {
  reserved
  applied
  manual_review
  skipped
}

/// Durable, at-most-once attempt to extend the same provider subscription before its finite count ends.
model RazorpaySubscriptionContinuation {
  id                    String @id @default(cuid())
  subscriptionId        String
  providerSubscriptionId String
  cycleEnd              DateTime
  observedTotalCount    Int
  observedPaidCount     Int
  observedRemainingCount Int
  targetRemainingCount  Int
  status                SubscriptionContinuationStatus @default(reserved)
  errorCategory         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  finishedAt            DateTime?
  subscription          Subscription @relation(fields: [subscriptionId, providerSubscriptionId], references: [id, razorpaySubscriptionId], onDelete: Restrict)

  @@unique([subscriptionId, cycleEnd])
  @@index([status, createdAt])
}

/// Durable binding between an authenticated checkout request and one provider subscription.
/// `creating` intents are never automatically retried because a lost response may hide a created provider subscription.
model RazorpaySubscriptionIntent {
  id                      String                           @id @default(cuid())
  userId                  String
  user                    User                             @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey          String
  autoRenewConsentAt      DateTime?
  autoRenewConsentVersion String?
  providerSubscriptionId  String?                          @unique
  checkoutUrl             String?
  providerPlanId          String
  planId                  String
  interval                BillingInterval
  /// Null only for legacy subscriptions whose historical amount was not independently verified.
  amountPaise             Int?
  currency                String                           @default("INR")
  status                  RazorpaySubscriptionIntentStatus @default(creating)
  errorCategory           String?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  subscription            Subscription?
  payments                PaymentRecord[]

  @@unique([id, userId])
  @@unique([providerSubscriptionId, userId, planId, interval])

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

/// Durable owner-bound one-time access purchase. A lost provider response stays manual_review.
model ManualPaymentIntent {
  id                String                   @id @default(cuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey    String
  providerPaymentLinkId String?               @unique
  checkoutUrl       String?
  planId            String
  interval          BillingInterval
  amountPaise       Int
  currency          String                   @default("INR")
  status            ManualPaymentIntentStatus @default(creating)
  accessStartsAt    DateTime?
  accessEndsAt      DateTime?
  errorCategory     String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  payments          PaymentRecord[]
  accessGrant       ManualPlanAccess?
  promotionRedemptions PromotionRedemption[]

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
}

/// Historical, verified paid period. Each captured payment can grant access only once.
model ManualPlanAccess {
  id                 String             @id @default(cuid())
  userId             String
  intentId           String             @unique
  providerPaymentId  String             @unique
  planId             String
  startsAt           DateTime
  expiresAt          DateTime
  createdAt          DateTime           @default(now())
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  intent             ManualPaymentIntent @relation(fields: [intentId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([intentId, userId])
  @@index([userId, expiresAt])
}

/// A versioned offer or one-user admin grant. Terms should be immutable after first use.
model Promotion {
  id               String                 @id @default(cuid())
  type             PromotionType
  status           PromotionStatus        @default(draft)
  /// Coupon code stored as trimmed uppercase. Null for code-free admin grants.
  code             String?                @unique
  discountType     PromotionDiscountType?
  /// Whole percentage points (1..50) or fixed paise.
  discountValue    Int?
  /// String constrained to creator/pro/agency for access promotions.
  accessPlanId     String?
  durationDays     Int?
  eligiblePlanIds  String[]               @default([])
  targetUserId     String?
  targetUser       User?                  @relation("PromotionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  startsAt         DateTime               @db.Timestamptz(3)
  expiresAt        DateTime?              @db.Timestamptz(3)
  usageLimit       Int?
  createdByAdminId String
  createdByAdmin   User                   @relation("PromotionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  reason           String?
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  redemptions      PromotionRedemption[]
  accessGrants     PromotionalAccessGrant[]
  lifecycleEvents  PromotionLifecycleEvent[]

  @@index([type, status, startsAt, expiresAt])
  @@index([targetUserId, status])
}

/// A reserved or completed coupon use. Price fields are an immutable checkout snapshot.
model PromotionRedemption {
  id                        String                    @id @default(cuid())
  promotionId               String
  promotion                 Promotion                 @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  userId                    String
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                    PromotionRedemptionStatus @default(reserved)
  idempotencyKey            String
  /// Populated only for discount-coupon redemptions; null for free-access coupons.
  planId                    String?
  interval                  BillingInterval?
  listPricePaise            Int?
  discountPaise             Int?
  payablePaise              Int?
  currency                  String?
  /// Both optional columns are set together and SQL-check-matched to userId.
  manualPaymentIntentId     String?
  manualPaymentIntentUserId String?
  manualPaymentIntent      ManualPaymentIntent?      @relation(fields: [manualPaymentIntentId, manualPaymentIntentUserId], references: [id, userId], onDelete: Restrict)
  reservedAt                DateTime                  @db.Timestamptz(3)
  redeemedAt                DateTime?                 @db.Timestamptz(3)
  releasedAt                DateTime?                 @db.Timestamptz(3)
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(3)
  accessGrant               PromotionalAccessGrant?
  lifecycleEvents           PromotionLifecycleEvent[]

  @@unique([userId, idempotencyKey])
  /// A user may redeem a promotion once across every lifecycle status, including released.
  @@unique([promotionId, userId])
  @@unique([id, userId])
  @@unique([id, userId, promotionId])
  @@unique([manualPaymentIntentId, manualPaymentIntentUserId])
  @@index([promotionId, status, createdAt])
  @@index([userId, createdAt])
}

/// A promotional entitlement. Queued grants have no finalized start or expiry dates.
model PromotionalAccessGrant {
  id                    String                    @id @default(cuid())
  promotionId           String
  promotion             Promotion                 @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  userId                String
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  redemptionId          String?                   @unique
  redemptionUserId      String?
  redemptionPromotionId String?
  redemption            PromotionRedemption?      @relation(fields: [redemptionId, redemptionUserId, redemptionPromotionId], references: [id, userId, promotionId], onDelete: Restrict)
  kind                  PromotionalAccessKind
  activationPolicy      PromotionActivationPolicy
  status                PromotionalAccessStatus  @default(queued)
  planId                String
  durationDays          Int
  /// Global monotonically increasing queue order; gaps after rollback are harmless.
  queueSequence         BigInt                    @default(autoincrement()) @unique
  startsAt              DateTime?                 @db.Timestamptz(3)
  expiresAt             DateTime?                 @db.Timestamptz(3)
  activatedAt           DateTime?                 @db.Timestamptz(3)
  revokedAt             DateTime?                 @db.Timestamptz(3)
  grantedByAdminId      String?
  grantedByAdmin        User?                     @relation("PromotionGrantor", fields: [grantedByAdminId], references: [id], onDelete: Restrict)
  reason                String?
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(3)
  lifecycleEvents       PromotionLifecycleEvent[]

  @@unique([id, userId, promotionId])
  @@index([userId, status, queueSequence])
  @@unique([redemptionId, redemptionUserId, redemptionPromotionId])
  @@index([status, startsAt, expiresAt])
}

/// Append-only, idempotent promotion lifecycle/audit evidence.
model PromotionLifecycleEvent {
  id                    String                       @id @default(cuid())
  eventKey              String                       @unique
  eventType             PromotionLifecycleEventType
  promotionId           String
  promotion             Promotion                    @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  subjectUserId         String?
  subjectUser           User?                        @relation("PromotionEventSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actorUserId           String?
  actorUser             User?                        @relation("PromotionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  redemptionId          String?
  redemptionUserId      String?
  redemptionPromotionId String?
  redemption            PromotionRedemption?         @relation(fields: [redemptionId, redemptionUserId, redemptionPromotionId], references: [id, userId, promotionId], onDelete: Restrict)
  accessGrantId         String?
  accessGrantUserId     String?
  accessGrantPromotionId String?
  accessGrant           PromotionalAccessGrant?      @relation(fields: [accessGrantId, accessGrantUserId, accessGrantPromotionId], references: [id, userId, promotionId], onDelete: Restrict)
  occurredAt            DateTime                     @db.Timestamptz(3)
  outcome               String?
  metadata              Json?
  createdAt             DateTime                     @default(now()) @db.Timestamptz(3)

  @@index([promotionId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model WebhookEvent {
  id              String             @id @default(cuid())
  /**
   * Razorpay's event id: the unique key that makes webhook handling idempotent.
   */
  providerEventId String             @unique
  eventType       String
  status          WebhookEventStatus @default(received)
  errorMessage    String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
}

model PaymentRecord {
  id                String   @id @default(cuid())
  userId            String
  providerPaymentId String   @unique
  /// CHECK payment_amount_non_negative: amountPaise >= 0. Prisma cannot represent CHECK constraints.
  amountPaise       Int // integer paise, never floats
  currency          String   @default("INR")
  status            String
  subscriptionIntentId String?
  subscriptionIntent RazorpaySubscriptionIntent? @relation(fields: [subscriptionIntentId, userId], references: [id, userId], onDelete: Restrict)
  /// CHECK PaymentRecord_single_billing_intent: at most one intent FK is non-null. Prisma cannot represent CHECK constraints.
  manualPaymentIntentId String?
  manualPaymentIntent ManualPaymentIntent? @relation(fields: [manualPaymentIntentId, userId], references: [id, userId], onDelete: Restrict)
  providerSubscriptionId String?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([subscriptionIntentId])
}

// ============================ Social accounts ============================
model SocialAccount {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform             SocialPlatform
  externalAccountId    String
  username             String?
  /**
   * Encrypted at rest by the application. Never log this.
   */
  encryptedAccessToken String?
  tokenExpiresAt       DateTime?
  /// BUSINESS, MEDIA_CREATOR, PERSONAL, or UNKNOWN. Not a secret.
  accountType          String?
  /// Space-separated Meta permission names. Never an access token.
  grantedScopes        String?
  status               SocialAccountStatus @default(connected)
  createdAt            DateTime            @default(now())

  cycles PublishingCycle[]
  publishingJobs PublishingJob[]

  @@unique([userId, platform, externalAccountId])
}

// ============================ Media ============================
model MediaAsset {
  id                String       @id @default(cuid())
  /**
   * The OWNER. Using a shared video never changes this.
   */
  ownerId           String
  owner             User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  kind              MediaKind
  status            MediaStatus  @default(active)
  originalFilename  String
  mimeType          String
  /**
   * Key of the private S3 object. One physical object per row.
   */
  storageKey        String       @unique
  /// CHECK media_size_non_negative: sizeBytes >= 0. Prisma cannot represent CHECK constraints.
  sizeBytes         BigInt
  durationMs        Int?
  width             Int?
  height            Int?
  checksumSha256    String?
  /// Storage key of the small JPEG preview image (or null if none could be made). Never sent to browsers.
  thumbnailKey      String?
  /// true = ffprobe decoded the file; false = accepted by file signature only (metadata check incomplete)
  metadataValidated Boolean      @default(false)
  /**
   * Set while status = pending_deletion: recipients keep access until this moment.
   * CHECK media_pending_deletion_has_date: status pending_deletion requires deleteAfter.
   * Prisma cannot represent CHECK constraints.
   */
  deleteAfter       DateTime?
  /**
   * Provenance when this row is an independent import of someone else's video.
   */
  importedFromId    String?
  importedFrom      MediaAsset?  @relation("ImportedCopies", fields: [importedFromId], references: [id], onDelete: SetNull)
  importedCopies    MediaAsset[] @relation("ImportedCopies")
  createdAt         DateTime     @default(now())

  derivatives     MediaDerivative[]
  collectionItems CollectionItem[]
  collectionItemsWithCover CollectionItem[] @relation("CollectionItemCover")
  collectionsWithSharedCover VideoCollection[] @relation("CollectionSharedCover")
  cycleItems      CycleItem[]       @relation("CycleItemMedia")
  coverForItems   CycleItem[]       @relation("CycleItemCover")
  importJobs      MediaImportJob[]  @relation("ImportSource")
  replacementSources EditedMediaReplacement[] @relation("EditedReplacementSource")
  replacementOutputs EditedMediaReplacement[] @relation("EditedReplacementOutput")

  @@index([ownerId, status, createdAt])
  @@index([status, deleteAfter])
}

/**
 * Thumbnails and rendered outputs. Owned by whoever caused the render (may differ from the source owner).
 */
model MediaDerivative {
  id           String         @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  ownerId      String
  kind         DerivativeKind
  storageKey   String         @unique
  sizeBytes    BigInt
  /**
   * Hash of the render settings. Same source + same settings = reuse, do not render again.
   */
  settingsHash String
  createdAt    DateTime       @default(now())

  selectedByCycleItems CycleItem[] @relation("CycleItemSelectedRenderOutput")
  replacementSources EditedMediaReplacement[] @relation("EditedReplacementDerivative")

  @@unique([mediaAssetId, ownerId, kind, settingsHash])
  @@unique([id, ownerId, mediaAssetId])
}

// ============================ Collections & sharing ============================
model VideoCollection {
  id          String               @id @default(cuid())
  ownerId     String
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  description String?
  visibility  CollectionVisibility @default(private)
  archived    Boolean              @default(false)
  captionMode CollectionSettingMode @default(individual)
  sharedCaptionText String?
  coverMode CollectionSettingMode @default(individual)
  sharedCoverMediaId String?
  sharedCoverMedia MediaAsset? @relation("CollectionSharedCover", fields: [sharedCoverMediaId], references: [id], onDelete: SetNull)
  settingsVersion Int @default(1)
  createdAt   DateTime             @default(now())

  items          CollectionItem[]
  shareLinks     CollectionShareLink[]
  permissions    CollectionPermission[]
  accessRequests CollectionAccessRequest[]

  @@index([ownerId, archived])
  @@index([sharedCoverMediaId])
}

model CollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  collection   VideoCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  position     Int
  captionText String @default("")
  coverMediaId String?
  coverMedia MediaAsset? @relation("CollectionItemCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  version Int @default(1)
  addedAt      DateTime        @default(now())

  @@unique([collectionId, mediaAssetId])
  @@index([collectionId, position])
  @@index([coverMediaId])
}

/// Durable, resumable promotion of one verified render into an independent MediaAsset.
/// membershipSnapshot stores only collection item IDs, collection IDs, and versions; it
/// contains no storage keys or user-provided data. Finalization rechecks this snapshot.
model EditedMediaReplacement {
  id                     String                       @id
  ownerId                String
  owner                  User                         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceMediaAssetId     String
  sourceMediaAsset       MediaAsset                   @relation("EditedReplacementSource", fields: [sourceMediaAssetId], references: [id], onDelete: Restrict)
  sourceDerivativeId     String
  sourceDerivative       MediaDerivative              @relation("EditedReplacementDerivative", fields: [sourceDerivativeId, ownerId, sourceMediaAssetId], references: [id, ownerId, mediaAssetId], onDelete: Restrict)
  /// Reserved deterministic ID before the object is copied. This is not an FK because the MediaAsset is created later.
  plannedReplacementMediaAssetId String                @unique
  /// Set only after the copied media row and verification job are committed.
  replacementMediaAssetId String?                     @unique
  replacementMediaAsset  MediaAsset?                  @relation("EditedReplacementOutput", fields: [replacementMediaAssetId], references: [id], onDelete: Restrict)
  stagingObjectKey       String?
  status                 EditedMediaReplacementStatus @default(queued)
  idempotencyKey         String                       @unique
  membershipSnapshot     Json                         @db.JsonB
  attempts               Int                          @default(0)
  lockedBy               String?
  lockToken              String?
  lockExpiresAt          DateTime?
  errorCode              String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  completedAt            DateTime?

  @@unique([ownerId, sourceMediaAssetId, sourceDerivativeId])
  @@index([status, lockExpiresAt, createdAt])
  @@index([ownerId, sourceMediaAssetId])
}

model CollectionShareLink {
  id           String          @id @default(cuid())
  collectionId String
  collection   VideoCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /**
   * SHA-256 of the token. The token itself is shown once and never stored.
   */
  tokenHash    String          @unique
  capabilities Capability[]
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime        @default(now())
}

model CollectionAccessRequest {
  id                    String              @id @default(cuid())
  collectionId          String
  collection            VideoCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  requesterId           String
  requester             User                @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requestedCapabilities Capability[]
  status                AccessRequestStatus @default(pending)
  decidedById           String?
  decidedAt             DateTime?
  createdAt             DateTime            @default(now())

  /// One pending request per requester per collection. Approved and rejected rows are kept.
  @@unique([collectionId, requesterId], name: "collection_access_request_one_pending", map: "collection_access_request_one_pending", where: raw("(status = 'pending'::\"AccessRequestStatus\")"))
  @@index([collectionId, status])
}

/**
 * One row per (collection, person). Merges the brief's "CollectionPermission" and "MediaUsageGrant".
 */
model CollectionPermission {
  id           String          @id @default(cuid())
  collectionId String
  collection   VideoCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  granteeId    String
  grantee      User            @relation(fields: [granteeId], references: [id], onDelete: Cascade)
  capabilities Capability[]
  status       GrantStatus     @default(active)
  expiresAt    DateTime?
  grantedById  String?
  revokedAt    DateTime?
  createdAt    DateTime        @default(now())

  @@unique([collectionId, granteeId])
  @@index([granteeId, status])
}

model MediaImportJob {
  id                 String       @id @default(cuid())
  importerId         String
  importer           User         @relation(fields: [importerId], references: [id], onDelete: Cascade)
  sourceMediaId      String
  sourceMedia        MediaAsset   @relation("ImportSource", fields: [sourceMediaId], references: [id], onDelete: Restrict)
  sourceCollectionId String?
  status             ImportStatus @default(pending)
  /**
   * importer + source: a retry can never create a second copy.
   */
  idempotencyKey     String       @unique
  /**
   * Where the new copy is being written. Used to delete orphans if the job fails.
   */
  newObjectKey       String?
  /// Current worker's unpredictable staging object key; each reclaim receives a fresh key.
  stagingObjectKey   String?
  lockedBy           String?
  lockToken          String?
  leaseExpiresAt     DateTime?
  attempts           Int          @default(0)
  /// Attempt keys are retained so a restarted worker can clean abandoned partial copies.
  attemptStorageKeys String[]     @default([])
  resultMediaAssetId String?      @unique
  failureReason      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([sourceMediaId, status])
  @@index([status, leaseExpiresAt])
}

// ============================ Templates ============================
model EditingTemplate {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /**
   * Aspect ratio, background, zoom, border, overlays... validated in application code.
   */
  settings  Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// ============================ Publishing cycles ============================
model PublishingCycle {
  id                   String         @id @default(cuid())
  ownerId              String
  owner                User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  socialAccountId      String
  socialAccount        SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  name                 String
  status               CycleStatus    @default(draft)
  finalReviewConfirmed Boolean        @default(false)
  orderMode            OrderMode      @default(manual)
  repeatBehavior       RepeatBehavior @default(never)
  timezone             String         @default("Asia/Kolkata")
  /**
   * Interval, days of week, time windows, daily maximum, end date. Validated in application code.
   */
  scheduleSettings     Json
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  items CycleItem[]
  publishingJobs PublishingJob[]

  @@index([ownerId, status])
}

model CycleItem {
  id                 String          @id @default(cuid())
  cycleId            String
  cycle              PublishingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /**
   * The user running the cycle (needed to re-check shared permissions).
   */
  cycleOwnerId       String
  /**
   * Restrict: a database cascade must never remove a video someone still needs.
   */
  mediaAssetId       String
  mediaAsset         MediaAsset      @relation("CycleItemMedia", fields: [mediaAssetId], references: [id], onDelete: Restrict)
  selectedRenderOutputId String?
  selectedRenderOwnerId String?
  selectedRenderSourceMediaId String?
  selectedRenderOutput MediaDerivative? @relation("CycleItemSelectedRenderOutput", fields: [selectedRenderOutputId, selectedRenderOwnerId, selectedRenderSourceMediaId], references: [id, ownerId, mediaAssetId], onDelete: SetNull, map: "CycleItem_selectedRenderOutput_fkey")
  sourceKind         SourceKind
  sourceCollectionId String?
  status             CycleItemStatus @default(upcoming)
  position           Int
  /**
   * Optimistic lock. Every UPDATE must use WHERE id = ? AND version = ? and increase it by 1.
   * CHECK cycle_item_version_positive: version >= 1. Prisma cannot represent CHECK constraints.
   */
  version            Int             @default(1)
  scheduledFor       DateTime?
  /**
   * Recipient-specific edit settings (aspect ratio, border, overlays...). The source is never modified.
   */
  editingSettings    Json?
  templateId         String?
  captionText        String          @default("")
  captionSource      CaptionSource   @default(none)
  coverMediaId       String?
  coverMedia         MediaAsset?     @relation("CycleItemCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  coverIsCustom      Boolean         @default(false)
  /**
   * saved_internally = stored in ClipForge only. applied_on_instagram is set ONLY by the publisher.
   */
  coverState         CoverState      @default(none)
  lockedBy           String?
  lockExpiresAt      DateTime?
  reviewReason       String?
  externalPostId     String?
  publishedAt        DateTime?
  createdAt          DateTime        @default(now())

  captionRevisions CaptionRevision[]
  coverChanges     CoverImageSelection[]
  publishAttempts  PublishingJob[]
  processingJobs   ProcessingJob[]

  /// The scheduler's main query: due items of running cycles.
  @@index([status, scheduledFor])
  @@index([cycleId, status, position])
  @@index([mediaAssetId, status])
  @@index([selectedRenderOutputId])
}

model CaptionRevision {
  id           String              @id @default(cuid())
  cycleItemId  String
  cycleItem    CycleItem           @relation(fields: [cycleItemId], references: [id], onDelete: Cascade)
  previousText String
  newText      String
  source       CaptionChangeSource
  changedById  String
  changedAt    DateTime            @default(now())

  @@index([cycleItemId, changedAt])
}

/**
 * History of cover choices. "saved" does not mean Instagram accepted it - see CycleItem.coverState.
 */
model CoverImageSelection {
  id              String    @id @default(cuid())
  cycleItemId     String
  cycleItem       CycleItem @relation(fields: [cycleItemId], references: [id], onDelete: Cascade)
  previousCoverId String?
  newCoverId      String?
  changedById     String
  changedAt       DateTime  @default(now())

  @@index([cycleItemId, changedAt])
}

// ============================ Jobs ============================
model ProcessingJob {
  id              String     @id @default(cuid())
  ownerId         String
  kind            JobKind
  status          JobStatus  @default(queued)
  cycleItemId     String?
  cycleItem       CycleItem? @relation(fields: [cycleItemId], references: [id], onDelete: SetNull)
  mediaAssetId    String?
  progressPercent Int        @default(0)
  attempts        Int        @default(0)
  idempotencyKey  String     @unique
  lockedBy        String?
  lockExpiresAt   DateTime?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  finishedAt      DateTime?
  /// SHA-256 of the render settings. Null until a render job uses this row.
  settingsHash       String?
  /// Edit settings and related media ids. No filesystem path or storage key.
  payload            Json?
  /// Id reserved for the new render file before FFmpeg starts. The original file is never this id.
  pendingOutputId    String?
  /// Set only after a MediaDerivative row exists for this render.
  outputDerivativeId String?
  /// Random claim token. A worker may finish a job only when this still matches.
  lockToken          String?
  /// Pid of the FFmpeg child spawned by the worker that holds lockToken. Not used to kill another process.
  ffmpegPid          Int?
  ffmpegStartedAt    DateTime?

  @@index([status, createdAt])
}

/// Local development copies of confirmation messages. The body is ciphertext, never a raw link.
model LocalEmailMessage {
  id             String   @id
  toAddress      String
  subject        String
  bodyCiphertext String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([toAddress, createdAt])
  @@index([expiresAt])
}

/**
 * One row per attempt to publish. Ambiguous results are kept for human review, never auto-retried.
 */
model PublishingJob {
  id               String             @id @default(cuid())
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  cycleId          String
  cycle            PublishingCycle    @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  cycleItemId      String
  cycleItem        CycleItem          @relation(fields: [cycleItemId], references: [id], onDelete: Cascade)
  socialAccountId  String
  socialAccount    SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  attemptNumber    Int
  idempotencyKey   String             @unique
  stage            PublishingJobStage @default(queued)
  outcome          PublishOutcome     @default(in_progress)
  workerId         String?
  lockToken        String?
  leaseExpiresAt   DateTime?
  containerId      String?
  /// Set only after a confirmed publish transition; database CHECK is in the hand-written migration.
  instagramMediaId String?
  /// Fixed, allowlisted category and generic summary only. Never raw provider response text.
  errorCategory    String?
  errorDetails     String?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  startedAt        DateTime           @default(now())
  finishedAt       DateTime?

  @@unique([cycleItemId, attemptNumber])
  @@index([stage, leaseExpiresAt])
  @@index([socialAccountId, stage, createdAt])
  // SQL-only partial unique index in the hand-written migration: one active attempt per account.
}

// ============================ Notifications, usage, audit ============================
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  /**
   * Same event + same user = same key, so job retries cannot send duplicates.
   */
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model UsageRecord {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           UsageKind
  amount         BigInt
  periodStart    DateTime
  /**
   * Retries of the same job cannot be counted twice.
   */
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  @@index([userId, kind, periodStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  /**
   * Never put secrets, tokens or signed URLs in here.
   */
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
